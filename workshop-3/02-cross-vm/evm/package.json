{
  "name": "qday-cross-vm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workshop 3: an EVM contract that writes into a QoreChain Native contract in the same transaction, through the CrossVM bridge.",
  "scripts": {
    "forge-std": "forge install foundry-rs/forge-std --no-git",
    "build": "forge build",
    "test": "forge test",
    "window": "tsx --env-file=.env scripts/window.ts",
    "window:scoped": "QORE_WINDOW_BLOCKS=1200 QORE_WINDOW_TXS=6 QORE_WINDOW_MAX_UQOR=3000000 tsx --env-file=.env scripts/window.ts open",
    "deploy:testnet": "forge script script/CrossVmCheckout.s.sol --rpc-url qorechain_testnet --broadcast",
    "xvm": "tsx --env-file=.env scripts/xvm.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/sdk": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "viem": "^2.0.0"
  }
}

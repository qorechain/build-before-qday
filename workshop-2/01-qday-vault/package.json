{
  "name": "qday-vault",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A vault that only releases funds with an ML-DSA-87 signature, verified on chain by the pqcVerify precompile.",
  "scripts": {
    "forge-std": "forge install foundry-rs/forge-std --no-git",
    "build": "forge build",
    "test": "forge test",
    "window": "tsx --env-file=.env scripts/window.ts",
    "deploy:testnet": "forge script script/QDayVault.s.sol --rpc-url qorechain_testnet --broadcast",
    "typecheck": "tsc --noEmit",
    "vault": "tsx --env-file=.env scripts/vault.ts",
    "window:scoped": "QORE_WINDOW_BLOCKS=600 QORE_WINDOW_TXS=3 QORE_WINDOW_MAX_UQOR=2000000 tsx --env-file=.env scripts/window.ts open"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/sdk": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "viem": "^2.0.0"
  }
}
